# Obsidian relayer configuration. Copy to `.env` for local dev. NEVER commit `.env`.

# ── Server ──────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0
PORT=8080

# Browser origins allowed to call the relayer (CORS), comma-separated.
# In production set this to your Vercel URL, e.g.:
# ALLOWED_ORIGINS=https://obsidian-web-topaz.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Relayer hot wallet ──────────────────────────────────────────────────────
# The key that pays gas and receives fees. Fund it with (testnet) ETH.
# NEVER commit a real key.
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY

# ── Fee knobs ───────────────────────────────────────────────────────────────
ETH_PRICE_USD=3000        # assumed ETH price (testnet ETH has none)
FEE_MARGIN_BPS=2000       # +20% margin on top of estimated gas cost
MIN_FEE_USDC=1000000      # floor fee, in 6-decimal USDC units (= 1 USDC)

# ── Chains ──────────────────────────────────────────────────────────────────
# Comma-separated chain ids, then RPC_<id> + VAULT_<id> for each.
#
# Testnet:
# CHAINS=11155111,421614,84532
# RPC_11155111=https://eth-sepolia.g.alchemy.com/v2/KEY
# VAULT_11155111=0x...
# RPC_421614=https://arb-sepolia.g.alchemy.com/v2/KEY
# VAULT_421614=0x...
# RPC_84532=https://base-sepolia.g.alchemy.com/v2/KEY
# VAULT_84532=0x...
#
# Local hardhat:
CHAINS=31337
RPC_31337=http://127.0.0.1:8545
VAULT_31337=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
